<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Window background = app theme (light/dark): the bars are
             transparent and this area (clipped by the ROM in the WebView)
             shows behind them → it adapts to the dashboard theme. The
             viewer paints it dark when opened (ImmersiveModePlugin). -->
        <item name="android:windowBackground">@color/window_background</item>
        <!-- Solid system bars, edge-to-edge (like Vivi's enableEdgeToEdge) -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/navigation_bar</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Window background = theme color, not splash.png (pure black):
             the strips clipped by the ROM show this color → they adapt to
             the app theme (light/dark) and to the viewer. -->
        <item name="android:background">@color/window_background</item>
        <!-- The window draws BEHIND the cutout (no ROM overlay): the app
             content is visible through the status bar. -->
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>